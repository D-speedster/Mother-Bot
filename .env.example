# توکن ربات تلگرام خود را از @BotFather دریافت کنید
BOT_TOKEN=your_bot_token_here

# کلید رمزنگاری Fernet برای امنیت توکن‌های ربات‌ها
# برای تولید کلید جدید از Python استفاده کنید:
#   from cryptography.fernet import Fernet
#   print(Fernet.generate_key().decode())
FERNET_KEY=JKuqMXDlJb0wRgbtckHbCflkE7BRtLa3rdEnM9XnNP4=

# مسیر فایل پایگاه داده SQLite (اختیاری - پیش‌فرض: mother_bot.db)
DATABASE_PATH=mother_bot.db

# هزینه ساخت ربات (تومان) - پیش‌فرض: 50000
BOT_CREATION_COST=50000

# اطلاعات کارت بانکی برای شارژ کیف پول
BANK_CARD_NUMBER=6037-9977-1234-5678
BANK_CARD_HOLDER=علی احمدی
BANK_NAME=بانک ملی ایران

# نام کاربری پشتیبانی
SUPPORT_USERNAME=YourSupportUsername

# اطلاعات تماس
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=021-12345678

# ⚠️ NOTE: AI Image Bot Admin Panel از Owner-Based Authorization استفاده می‌کند
# هر کاربری که Bot می‌سازد، به صورت خودکار Owner و Admin آن Bot می‌شود
# نیازی به تنظیم Admin ID در Environment Variable نیست

# ========== Telegram Local Bot API Server Configuration ==========
# Local Bot API برای پشتیبانی از فایل‌های بزرگ (تا ~2GB) استفاده می‌شود
# این تنظیمات فقط برای File Transfer Bot نیاز است و بر روی سایر Bot‌ها تأثیری ندارد

# فعال/غیرفعال کردن Local Bot API (yes/no, true/false, 1/0)
# پیش‌فرض: no (از Standard Telegram API استفاده می‌شود)
TELEGRAM_LOCAL_API_ENABLED=no

# آدرس پایه Local Bot API Server (فقط اگر ENABLED=yes)
# پیش‌فرض: http://localhost
TELEGRAM_LOCAL_API_BASE_URL=http://localhost

# پورت Local Bot API Server (فقط اگر ENABLED=yes)
# پیش‌فرض: 8081
TELEGRAM_LOCAL_API_PORT=8081

# ⚠️ توکن تست برای Health Check
# این توکن فقط برای تست سلامت Local API Server استفاده می‌شود
# می‌توانید از یک Bot تست اختصاصی استفاده کنید
# اگر خالی باشد، Health Check انجام نمی‌شود
TELEGRAM_LOCAL_API_TEST_TOKEN=

# ⚠️ SECURITY NOTES:
# - api_id و api_hash را در این فایل قرار ندهید
# - این اطلاعات باید هنگام راه‌اندازی Local Bot API Server به آن داده شوند
# - هیچ‌وقت api_id/api_hash را در git commit نکنید
