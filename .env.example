# ================================
# تنظیمات محیطی Mother Bot
# ================================
# این فایل رو کپی کن به .env و مقادیر واقعی رو جایگزین کن

# توکن ربات اصلی (از @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# کلید رمزنگاری Fernet (با اجرای python generate_key.py تولید کن)
FERNET_KEY=kQw7hJ_9XvL2nR4tYpM8bZ1cV5xS6uA3dG0fH4iK7jN=

# مسیر دیتابیس (اختیاری - پیش‌فرض: mother_bot.db)
DATABASE_PATH=mother_bot.db

# هزینه ساخت ربات به تومان (اختیاری - پیش‌فرض: 50000)
BOT_CREATION_COST=50000

# آیدی تلگرام ادمین اصلی (از @userinfobot بگیر)
ADMIN_USER_ID=79049016

# اطلاعات کارت بانکی برای واریز (کارت به کارت)
BANK_CARD_NUMBER=6037-9977-1234-5678
BANK_CARD_HOLDER=علی احمدی
BANK_NAME=بانک ملی ایران

# ================================
# تنظیمات Local Bot API (اختیاری)
