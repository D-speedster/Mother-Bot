# ================================
# تنظیمات Local Bot API (اختیاری)
# ================================
# اگر از Local Bot API استفاده می‌کنی:
# LOCAL_API_URL=http://localhost:8081
# LOCAL_API_TOKEN=your_local_api_token

# نام کاربری پشتیبانی
SUPPORT_USERNAME=YourSupportUsername

# اطلاعات تماس
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=021-12345678

# ========== Telegram Local Bot API Server Configuration ==========

TELEGRAM_LOCAL_API_ENABLED=no
TELEGRAM_LOCAL_API_BASE_URL=http://localhost
TELEGRAM_LOCAL_API_PORT=8081
TELEGRAM_LOCAL_API_TEST_TOKEN=

# ========== File Storage Configuration (File Transfer Bot) ==========

FILE_STORAGE_ENABLED=false
FILE_STORAGE_FTP_HOST=
FILE_STORAGE_FTP_PORT=21
FILE_STORAGE_FTP_USERNAME=
FILE_STORAGE_FTP_PASSWORD=
FILE_STORAGE_FTP_BASE_PATH=
FILE_STORAGE_PUBLIC_BASE_URL=
FILE_STORAGE_TTL_SECONDS=21600
FILE_STORAGE_MAX_FILE_SIZE_MB=2048